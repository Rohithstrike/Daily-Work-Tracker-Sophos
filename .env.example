# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon key OR the modern publishable key (sb_publishable_...).
# This is a public browser key. Security is enforced by Row Level Security.
# NEVER put a service-role key or an sb_secret_... key here.
VITE_SUPABASE_ANON_KEY=

# Default prefix used for exported Excel filenames, e.g. "OC September 2026.xlsx"
VITE_DEFAULT_REPORT_PREFIX=OC
